# ============================================
# ZaynClock Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# Your site's public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.zaynclock.com

# Google AdSense Publisher ID
# Get this from: https://www.google.com/adsense/
# Format: ca-pub-XXXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXXX

# AdSense ad unit slot numbers
NEXT_PUBLIC_ADSENSE_LEADERBOARD_SLOT=XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_RECTANGLE_SLOT=XXXXXXXXXX
# Optional responsive/auto-format unit
# NEXT_PUBLIC_ADSENSE_AUTO_SLOT=XXXXXXXXXX

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-2P3SL6QCHX

# Microsoft Clarity project ID for heatmaps and session recordings
NEXT_PUBLIC_CLARITY_ID=y28u2dpogr
